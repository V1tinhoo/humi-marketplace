# Copy this file to .env.local and fill in the values from
# Supabase Dashboard → Project Settings → API.
# If these two are empty, HUMI runs in demo mode (mock data + local demo auth).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# (or the legacy name) NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of the site, used in auth emails (confirmation / password reset).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# REQUIRED for calls and wallet (billing + top-up confirmation run on the server). Also used by `npm run db:seed`.
# NEVER prefix with NEXT_PUBLIC_, never import it in app code, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Video calls (LiveKit Cloud → Settings → Keys). Secret is server-only. ----
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Payments ----
# Mercado Pago (Pix + card). Server-only — never prefix with NEXT_PUBLIC_.
# Use TEST credentials first (balance is marked as test). Real money only with production credentials.
# Mercado Pago → Suas integrações → (app) → Credenciais.
MERCADOPAGO_ACCESS_TOKEN=
# Set "true" when using a test seller account whose token starts with APP_USR- (keeps balance as test).
MERCADOPAGO_SANDBOX=false
# Webhooks → "Assinatura secreta". Needed only once the site is public (https).
MERCADOPAGO_WEBHOOK_SECRET=

# Without Mercado Pago, a TEST provider adds *test balance* (livemode = false), no real money.
# It's enabled automatically in development; in production only if this is "true".
PAYMENTS_TEST_MODE=false
# Signs test-provider webhooks. Required when running more than one server instance.
PAYMENTS_TEST_WEBHOOK_SECRET=
